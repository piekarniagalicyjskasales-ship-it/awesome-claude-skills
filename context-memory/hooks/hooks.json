{
  "description": "context-memory: restore memory at session start, write a handoff before compaction and at session end",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/context-memory/scripts/memory.py\" hook session-start",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/context-memory/scripts/memory.py\" hook pre-compact",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/context-memory/scripts/memory.py\" hook session-end",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
